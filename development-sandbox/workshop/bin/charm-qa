#!/usr/bin/env bash
# Copyright 2026 Canonical Ltd.
# See LICENSE file for licensing details.
set -euo pipefail

usage() {
    cat <<'EOF'
Usage: charm-qa root
       charm-qa skills
       charm-qa run TASK [ARGS...]
       charm-qa exec -- COMMAND [ARGS...]

root/skills  Print the installed toolkit or skills directory.
run          Run a Mise task in the toolkit; use absolute paths for workspace inputs.
exec         Run a command with the toolkit environment, keeping the caller's directory.
EOF
}

case "${1:---help}" in
    --help|-h) usage; exit 0 ;;
    root|skills|run|exec) operation="$1"; shift ;;
    *) usage >&2; exit 1 ;;
esac
case "$operation" in
    root|skills) [[ $# == 0 ]] || { usage >&2; exit 1; } ;;
    run|exec) [[ $# -gt 0 ]] || { usage >&2; exit 1; } ;;
esac

sdk="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=../environment.sh
source "$sdk/environment.sh"

toolkit="$(realpath -e "$CHARM_QA_HOME/current")" || {
    echo "Charm QA is not prepared; inspect the Workshop setup-project hook." >&2
    exit 1
}
export PROJECT_ROOT="$toolkit"
export UV_PROJECT_ENVIRONMENT="$toolkit/.venv"
export MISE_TRUSTED_CONFIG_PATHS="$toolkit"
export CHARM_QA_WORKSPACE="$PWD"

case "$operation" in
    root) printf '%s\n' "$toolkit" ;;
    skills) printf '%s\n' "$toolkit/.agents/skills" ;;
    run) exec mise -C "$toolkit" run "$@" ;;
    exec)
        [[ "${1:-}" != -- ]] || shift
        [[ $# -gt 0 ]] || { usage >&2; exit 1; }
        exec mise -C "$toolkit" exec -- \
            bash -c 'cd "$1"; shift; exec uv run --project "$PROJECT_ROOT" --no-sync --all-packages -- "$@"' \
            bash "$CHARM_QA_WORKSPACE" "$@"
        ;;
esac
