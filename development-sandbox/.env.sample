# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.

# Fine-grained PAT for gh CLI inside the VM.
# Optional - if unset, gh CLI uses whatever auth is already present in the VM.
# Permissions: Contents (read), Pull requests (read and write).
# Repository access: All repositories.
# GITHUB_TOKEN=github_pat_...

# Fine-grained PAT for Copilot AI auth.
# Optional - defaults to 'gh auth token' on the host if not set.
# COPILOT_GITHUB_TOKEN=github_pat_...

# Optional overrides (can also be set in your shell environment).
# SANDBOX_VM=charm-qa-sandbox
# SANDBOX_MOUNT=/project
# COPILOT_MODEL=sonnet-4.6

# VM resource overrides (applied when creating a new VM).
# Can be set via environment variables or CLI flags (--cpus, --memory, --disk).
# SANDBOX_CPUS=4
# SANDBOX_MEMORY=8G
# SANDBOX_DISK=40G

# Auto-generated by scripts/sandbox.sh up - do not edit manually.
# SANDBOX_SIGNING_KEY=<base64-encoded ed25519 private key>

# MCP server configuration for sandbox.sh run.
# SANDBOX_MCP_CONFIG_FILE=/path/to/mcp.json

# Base URLs for bundle_builder_x's Charmhub/Snapcraft API clients.
# Optional - default to the production APIs. Passed through into the VM by
# scripts/sandbox.sh. Point at the local nginx cache instead, e.g.:
# (localhost here refers to localhost inside the VM, not the host machine)
# CHARMHUB_API_URL=http://localhost:8080/charmhub
# SNAPCRAFT_API_URL=http://localhost:8080/snapcraft

# test-observer-mcp configuration for sandbox.sh run --with-test-observer-mcp.
# TEST_OBSERVER_API_URL is required to use the flag; TEST_OBSERVER_API_KEY is
# optional (only needed for write operations like registering issues).
# TEST_OBSERVER_API_URL=https://test-observer-api.example.com
# TEST_OBSERVER_API_KEY=...
# TEST_OBSERVER_MCP_PORT=8090
