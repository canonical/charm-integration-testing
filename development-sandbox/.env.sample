# Copy this file to .env and fill in your values.
# .env is gitignored and never committed.
#
# OPTIONAL but recommended: set SANDBOX_VAR_GITHUB_TOKEN and SANDBOX_VAR_COPILOT_GITHUB_TOKEN
# below to narrowly scoped tokens. If either is unset, sandbox.sh up/run asks
# for your consent to pass your host `gh auth token` into the VM instead. That
# token has all the permissions of your host gh login, so anything running in
# the VM could act as you on GitHub. Without a terminal, or if you decline,
# sandbox.sh continues without GitHub authentication for the unset tokens.

# --- GitHub credentials ---

# Optional. Fine-grained PAT for GitHub API access on the host while
# provisioning the VM (e.g. registering the VM signing key).
# Defaults to the host's `gh auth token`.
# GITHUB_TOKEN=github_pat_...

# Fine-grained PAT used to log in the gh CLI inside the VM (overwrites any
# existing gh login there). If unset, falls back to the host's `gh auth token`
# after asking for your consent.
# Permissions: Contents (read), Pull requests (read and write).
# Repository access: All repositories.
# SANDBOX_VAR_GITHUB_TOKEN=github_pat_...

# Token Copilot CLI uses to authenticate inside the VM. If unset, falls back to
# the host's `gh auth token` after asking for your consent.
# SANDBOX_VAR_COPILOT_GITHUB_TOKEN=github_pat_...

# --- Copilot model ---

# Optional. Model used by Copilot inside the VM (default: sonnet-4.6).
# SANDBOX_VAR_COPILOT_MODEL=sonnet-4.6

# Optional. Use OpenRouter instead of GitHub-hosted models (Copilot CLI BYOK).
# Uncomment all three lines. The model must support tool calling and streaming.
# These replace the SANDBOX_VAR_COPILOT_MODEL line above (set it only once).
# Any SANDBOX_VAR_<NAME> is passed into the VM as <NAME>.
# SANDBOX_VAR_COPILOT_PROVIDER_BASE_URL=https://openrouter.ai/api/v1
# SANDBOX_VAR_COPILOT_PROVIDER_API_KEY=sk-or-...
# SANDBOX_VAR_COPILOT_MODEL=anthropic/claude-sonnet-4.5

# --- VM settings ---

# Optional. VM name and the path the project is mounted at inside the VM.
# SANDBOX_VM=charm-qa-sandbox
# SANDBOX_MOUNT=/project

# Optional. VM resource overrides (applied when creating a new VM).
# Can be set via environment variables or CLI flags (--cpus, --memory, --disk).
# SANDBOX_CPUS=4
# SANDBOX_MEMORY=8G
# SANDBOX_DISK=40G

# Do not set. Auto-generated and appended to this file by `sandbox.sh up`.
# SANDBOX_SIGNING_KEY=<base64-encoded ed25519 private key>

# Optional. Host path to an MCP server config JSON, used by `sandbox.sh run`.
# SANDBOX_MCP_CONFIG_FILE=/path/to/mcp.json

# Optional. Base URLs for bundle_builder_x's Charmhub/Snapcraft API clients.
# Default to the production APIs. Passed through into the VM by
# scripts/sandbox.sh. Point at the local nginx cache instead, e.g.:
# (localhost here refers to localhost inside the VM, not the host machine)
# SANDBOX_VAR_CHARMHUB_API_URL=http://localhost:8080/charmhub
# SANDBOX_VAR_SNAPCRAFT_API_URL=http://localhost:8080/snapcraft
