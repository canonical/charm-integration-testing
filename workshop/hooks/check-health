set -euo pipefail

if sudo -u workshop -H "$SDK/bin/charm-qa" exec -- \
    python -c 'import juju, jubilant, validators.engine'; then
    workshopctl set-health okay
else
    workshopctl set-health error "Charm QA dependencies are unavailable; inspect setup-project."
fi
