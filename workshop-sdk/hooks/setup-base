#!/usr/bin/env bash
# Copyright 2026 Canonical Ltd.
# See LICENSE file for licensing details.
set -euo pipefail

apt-get update
DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    ca-certificates curl git snapd

if ! /usr/bin/snap list mise >/dev/null 2>&1; then
    /usr/bin/snap install mise --classic --channel=stable
fi

ln -sfn "$SDK/environment.sh" /etc/profile.d/charm-qa.sh
