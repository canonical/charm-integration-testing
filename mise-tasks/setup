#!/usr/bin/env bash
#MISE description="Prepare project dependencies and lazy tools; optionally bootstrap system packages"
#MISE raw_args=true
# Copyright 2026 Canonical Ltd.
# See LICENSE file for licensing details.
set -euo pipefail

install_project="${SETUP_INSTALL_PROJECT-true}"
bootstrap="${SETUP_BOOTSTRAP:-false}"
for setting in "$install_project" "$bootstrap"; do
    case "$setting" in
        true|false) ;;
        *) echo "Setup boolean settings must be true or false" >&2; exit 1 ;;
    esac
done

while (( $# )); do
    case "$1" in
        --tools-only) install_project=false ;;
        --bootstrap) bootstrap=true ;;
        --) shift; break ;;
        *) break ;;
    esac
    shift
done

if [[ "$bootstrap" == true ]]; then
    mise run bootstrap-packages
fi

if [[ "$install_project" == true ]]; then
    mise run setup-project -- "$@"
else
    mise install --locked
fi
