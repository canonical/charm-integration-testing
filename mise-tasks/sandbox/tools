#!/usr/bin/env bash
#MISE description="Install sandbox developer tools"
set -euo pipefail

export MISE_ENV=development
export MISE_OVERRIDE_CONFIG_FILENAMES=mise.toml:development-sandbox/mise.toml
export GIT_CONFIG_GLOBAL="${GIT_CONFIG_GLOBAL:-/dev/null}"

mise install --locked uv
mise install --locked pipx
mise install --locked

mise exec -- bash -c '
    command -v copilot
    command -v helm
    command -v gh
    command -v yq
    command -v markdownlint-cli2
    command -v trufflehog
    command -v juju-k8s-crashdump
'
