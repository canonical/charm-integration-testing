#!/usr/bin/env bash
#MISE description="Require exactly one remote cloud credential field"
# Copyright 2026 Canonical Ltd.
# See LICENSE file for licensing details.
set -euo pipefail

count=0
for secret in "${KUBECONFIG_SECRET_NAME:-}" "${NOVARC_SECRET_NAME:-}" "${LXD_SECRET_NAME:-}"; do
    if [[ -n "$secret" ]]; then count=$((count + 1)); fi
done
if [[ "$count" != 1 ]]; then
    echo "::error::Expected exactly one remote cloud credential field." >&2
    exit 1
fi
