#!/usr/bin/env bash
#MISE description="Initialise local Canonical Kubernetes and register it as a Juju cloud"
#MISE raw_args=true
# Copyright 2026 Canonical Ltd.
# See LICENSE file for licensing details.
set -euo pipefail

usage() {
    cat <<'USAGE'
Usage: mise run setup-k8s -- [--cloud-name NAME] [--kubeconfig PATH] [--no-chaos-mesh]
                            [--output FILE]

Initialises Canonical Kubernetes with Concierge, registers it with the Juju client and installs or
verifies Chaos Mesh. Concierge writes the kubeconfig to $HOME/.kube/config.
This flushes the host's iptables FORWARD chain and sets its default policy to ACCEPT.

--cloud-name     Juju cloud name (default: local-k8s)
--kubeconfig     Also write a copy of the kubeconfig to PATH and use it (default: $HOME/.kube/config)
--no-chaos-mesh  Skip Chaos Mesh
--output         Append cloud-name, kubeconfig-path and platform as key=value lines
USAGE
}

die() {
    echo "ERROR: $*" >&2
    exit 1
}

cloud_name=local-k8s
kubeconfig=""
chaos_mesh=true
output=""
while (( $# )); do
    case "$1" in
        --cloud-name|--kubeconfig|--output)
            if (( $# < 2 )) || [[ -z "$2" ]]; then die "$1 requires a value"; fi
            case "$1" in
                --cloud-name) cloud_name="$2" ;;
                --kubeconfig) kubeconfig="$2" ;;
                --output) output="$2" ;;
            esac
            shift
            ;;
        --no-chaos-mesh) chaos_mesh=false ;;
        --help|-h) usage; exit 0 ;;
        *) usage >&2; die "Unknown argument: $1" ;;
    esac
    shift
done

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

for tool in concierge juju jq mise; do
    command -v "$tool" >/dev/null || die "Missing $tool; run: mise run setup -- --group local-k8s"
done

k8s_channel="$(mise config get --file "$project_root/mise.toml" 'bootstrap.packages."snap:k8s".channel')"
[[ -n "$k8s_channel" ]] || die "Missing Kubernetes snap channel in mise.toml"

# Override Concierge's default channel: https://github.com/canonical/concierge/issues/292.
echo "==> Preparing Canonical Kubernetes with Concierge..."
sudo "$(command -v concierge)" prepare --config "$project_root/static/substrates/k8s.yaml" \
    --k8s-channel "$k8s_channel" --verbose

# Match Concierge's LXD firewall handling until https://github.com/canonical/concierge/issues/288.
echo "==> Flushing the host's iptables FORWARD chain and setting its policy to ACCEPT..."
sudo iptables -F FORWARD
sudo iptables -P FORWARD ACCEPT

if [[ -n "$kubeconfig" ]]; then
    kubeconfig="$(realpath -m "$kubeconfig")"
    echo "==> Writing kubeconfig to $kubeconfig..."
    mkdir -p "$(dirname "$kubeconfig")"
    tmp_kubeconfig="$(mktemp "${kubeconfig}.XXXXXX")"
    trap 'rm -f -- "$tmp_kubeconfig"' EXIT
    # shellcheck disable=SC2024
    sudo k8s config > "$tmp_kubeconfig"
    mv -fT -- "$tmp_kubeconfig" "$kubeconfig"
    trap - EXIT
else
    kubeconfig="$HOME/.kube/config"
fi
[[ -f "$kubeconfig" && -r "$kubeconfig" ]] || die "Kubeconfig is not a readable file: $kubeconfig"

if juju clouds --client --format json | jq -e --arg cloud "$cloud_name" 'has($cloud)' >/dev/null; then
    echo "==> Juju cloud $cloud_name already registered."
else
    echo "==> Registering Juju cloud $cloud_name..."
    juju add-k8s "$cloud_name" --client < "$kubeconfig"
fi

if [[ "$chaos_mesh" == true ]]; then
    "$project_root/mise-tasks/setup-chaos-mesh" "$kubeconfig"
fi

if [[ -n "$output" ]]; then
    printf 'cloud-name=%s\nkubeconfig-path=%s\nplatform=kubernetes\n' \
        "$cloud_name" "$kubeconfig" >> "$output"
fi

kubeconfig_variable="KUBECONFIG_${cloud_name//-/_}"
cat <<NEXT

Kubernetes cloud $cloud_name is ready. To run tests against it:
  export $kubeconfig_variable=$kubeconfig
To bootstrap a controller manually:
  juju bootstrap $cloud_name <controller-name> --bootstrap-constraints root-disk=5G
NEXT
